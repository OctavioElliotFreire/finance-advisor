# Regex of allowed browser origins for CORS (only matters for Flutter Web,
# not mobile). Defaults to any localhost port if unset. Override in
# production to the real deployed Flutter Web origin(s).
CORS_ALLOWED_ORIGIN_REGEX=http://localhost(:\d+)?

# Base URL of the deployed Flutter Web app, used to build the redirect_to
# link in household invite emails. Must be allow-listed in Supabase's
# Authentication > URL Configuration > Redirect URLs.
FRONTEND_BASE_URL=http://localhost:8901
